{
  "version": 2,
  "installCommand": "cd travel-guide && npm ci",
  "functions": {
    "api/*.js": {
      "includeFiles": "travel-guide/data/**"
    }
  },
  "routes": [
    {
      "handle": "filesystem"
    },
    {
      "src": "/favicon.ico",
      "dest": "/travel-guide/public/favicon.ico"
    },
    {
      "src": "/",
      "dest": "/travel-guide/public/index.html"
    },
    {
      "src": "/(.*)",
      "dest": "/travel-guide/public/$1"
    }
  ]
}
