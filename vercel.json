{
  "version": 2,
  "builds": [
    {
      "src": "travel-guide/server.js",
      "use": "@vercel/node"
    },
    {
      "src": "travel-guide/public/**",
      "use": "@vercel/static"
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/travel-guide/server.js"
    },
    {
      "source": "/(.*)",
      "destination": "/travel-guide/public/$1"
    }
  ]
}
