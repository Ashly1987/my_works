{
  "version": 2,
  "builds": [
    {
      "src": "travel-guide/package.json",
      "use": "@vercel/node"
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/travel-guide/api/:path*"
    },
    {
      "source": "/",
      "destination": "/travel-guide/public/index.html"
    },
    {
      "source": "/:path+",
      "destination": "/travel-guide/public/:path+"
    }
  ]
}
